    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5",
    "@types/node": "^24.19.0",
    "jsdom": "^27",
    "pngjs": "^7.0.0",
