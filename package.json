{
  "name": "frogtend",
  "version": "0.46.3",
  "description": "Frogtend — la ludothèque de la maison, servie par Firehouse",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
