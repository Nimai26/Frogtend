{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frogtend",
  "version": "../package.json",
  "identifier": "fr.hikari-no-sekai.frogtend",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Frogtend",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost jaquette: http://jaquette.localhost boutique: http://boutique.localhost; media-src 'self' asset: http://asset.localhost fond: http://fond.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Nimai",
    "copyright": "Apache-2.0",
    "category": "Game",
    "shortDescription": "La ludothèque de la maison, servie par Firehouse",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzMjIxQTlBMDUzREYzOTcKUldTWDh6MEZtaG9pd3dERHB2Y0doeVgyTmN2Ym9yVVMzOGNRdXpDenFydkNabXhyaHdlTENGZEQK",
      "endpoints": [
        "https://github.com/Nimai26/Frogtend/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
